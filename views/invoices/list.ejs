<%- include('../partials/layout-start', { title: config.pluralLabel, activeNav: config.activeNav }) %>
<%
  var settles = !!config.settlementDirection;
  var paidWord = config.settlementDirection === 'OUT' ? 'Paid' : 'Received';
  var showDept = config.side === 'SALE';
  // Each column is shown when the listed documents use it (or it is being filtered), so an unused one takes no space
  var divs = invoices.map(function (inv) { return divisionOf(inv); });
  var showSectionCol = showDept && (!!filters.section || divs.some(function (d) { return d.section || d.unclassified; }));
  var showDepartmentCol = showDept && (!!filters.department || divs.some(function (d) { return d.department; }));
  var colCount = 6 + (showSectionCol ? 1 : 0) + (showDepartmentCol ? 1 : 0) + (settles ? 1 : 0);
  var anyFilter = filters.customerId || filters.paymentStatus || filters.q || filters.section || filters.department || filters.from || filters.to || filters.status;
  var createLabel = { SALE_INVOICE: 'New invoice', ESTIMATE: 'New estimate', PURCHASE_BILL: 'New purchase', CREDIT_NOTE: 'New sale return', DEBIT_NOTE: 'New purchase return' }[config.docType];
  var actions = config.returnOf
    ? '<a href="' + config.basePath + '/new" class="btn btn-outline-secondary">Return without a bill</a>'
    : (config.docType === 'PURCHASE_BILL' ? '<a href="/purchases/import" class="btn btn-outline-primary"><i class="icon-sparkles"></i> Import bill with AI</a>' : '') +
      '<a href="' + config.basePath + '/new" class="btn btn-primary"><i class="icon-plus"></i> ' + createLabel + '</a>';
  var subtitle = config.returnOf
    ? 'To return against a bill, open it and choose ' + (config.docType === 'CREDIT_NOTE' ? '“Sale return”.' : '“Purchase return”.')
    : (config.docType === 'ESTIMATE' ? 'Quotations do not affect stock or balances until converted.' : null);
%>
<div class="page" data-list-key="<%= config.basePath %>">
  <%- include('../partials/page-header', { title: config.pluralLabel, subtitle: subtitle, actions: actions }) %>

  <div class="kpi-grid">
    <div class="kpi"><div class="kpi-label">Total value</div><div class="kpi-value"><%= inr(summary.totalSales) %></div><div class="kpi-sub"><%= invoiceCount %> document<%= invoiceCount === 1 ? '' : 's' %><%= anyFilter ? ' (filtered)' : '' %></div></div>
    <% if (settles) { %>
      <div class="kpi"><div class="kpi-label"><%= paidWord %> / adjusted</div><div class="kpi-value text-success"><%= inr(summary.received) %></div></div>
      <div class="kpi"><div class="kpi-label">Outstanding</div><div class="kpi-value <%= summary.outstanding > 0 ? 'text-danger' : '' %>"><%= inr(summary.outstanding) %></div></div>
    <% } %>
  </div>

  <div class="panel">
    <form method="GET" action="<%= config.basePath %>" class="filter-bar" role="search">
      <div class="f f-search">
        <label class="form-label" for="fNo">Search</label>
        <div class="search-input"><i class="icon-search"></i><input type="search" id="fNo" name="q" class="form-control form-control-sm" placeholder="<%= showDept ? 'Number, customer, section or department' : 'Number or ' + config.partyLabel.toLowerCase() %>" value="<%= filters.q %>"></div>
      </div>
      <div class="f f-select-lg">
        <label class="form-label" for="fParty"><%= config.partyLabel %></label>
        <select id="fParty" name="customerId" class="form-select form-select-sm">
          <option value="">All</option>
          <% customers.forEach(function(c) { %><option value="<%= c.id %>" <%= filters.customerId === c.id ? 'selected' : '' %>><%= c.name %><%= c.section ? ' (' + c.section + ')' : '' %></option><% }) %>
        </select>
      </div>
      <% if (showDept) { %>
      <div class="f f-select">
        <label class="form-label" for="fSection">Section</label>
        <select id="fSection" name="section" class="form-select form-select-sm">
          <option value="">All</option>
          <option value="__none" <%= filters.section === '__none' ? 'selected' : '' %>>No section</option>
          <% sections.forEach(function(d) { %><option value="<%= d %>" <%= filters.section && filters.section.toLowerCase() === d.toLowerCase() ? 'selected' : '' %>><%= d %></option><% }) %>
        </select>
      </div>
      <div class="f f-select">
        <label class="form-label" for="fDept">Department</label>
        <select id="fDept" name="department" class="form-select form-select-sm">
          <option value="">All</option>
          <option value="__none" <%= filters.department === '__none' ? 'selected' : '' %>>No department</option>
          <% departments.forEach(function(d) { %><option value="<%= d %>" <%= filters.department && filters.department.toLowerCase() === d.toLowerCase() ? 'selected' : '' %>><%= d %></option><% }) %>
        </select>
      </div>
      <% } %>
      <div class="f f-date"><label class="form-label" for="fFrom">From</label><input type="date" id="fFrom" name="from" class="form-control form-control-sm" value="<%= filters.from %>"></div>
      <div class="f f-date"><label class="form-label" for="fTo">To</label><input type="date" id="fTo" name="to" class="form-control form-control-sm" value="<%= filters.to %>"></div>
      <% if (settles) { %>
      <div class="f f-select">
        <label class="form-label" for="fPay">Payment</label>
        <select id="fPay" name="paymentStatus" class="form-select form-select-sm">
          <option value="">Any</option>
          <option value="UNPAID" <%= filters.paymentStatus === 'UNPAID' ? 'selected' : '' %>>Unpaid</option>
          <option value="PARTIALLY_PAID" <%= filters.paymentStatus === 'PARTIALLY_PAID' ? 'selected' : '' %>>Partly paid</option>
          <option value="PAID" <%= filters.paymentStatus === 'PAID' ? 'selected' : '' %>>Paid</option>
        </select>
      </div>
      <% } %>
      <div class="f f-select">
        <label class="form-label" for="fStatus">Show</label>
        <select id="fStatus" name="status" class="form-select form-select-sm">
          <option value="">Active</option>
          <option value="CANCELLED" <%= filters.status === 'CANCELLED' ? 'selected' : '' %>>Cancelled</option>
          <option value="ALL" <%= filters.status === 'ALL' ? 'selected' : '' %>>All</option>
        </select>
      </div>
      <div class="f-actions">
        <% if (anyFilter) { %><a href="<%= config.basePath %>" class="btn btn-sm btn-outline-secondary">Clear</a><% } %>
        <button type="submit" class="btn btn-sm btn-primary"><i class="icon-filter"></i> Apply</button>
      </div>
    </form>

    <div class="table-scroll sticky">
      <table class="table table-app" data-sortable data-page-size="50">
        <thead>
          <tr>
            <th data-sort="date" style="width:118px">Date</th>
            <th data-sort="text" style="width:130px">Number</th>
            <th data-sort="text"><%= config.partyLabel %></th>
            <% if (showSectionCol) { %><th data-sort="text" style="width:150px">Section</th><% } %>
            <% if (showDepartmentCol) { %><th data-sort="text" style="width:150px">Department</th><% } %>
            <th data-sort="num" class="num" style="width:130px">Amount</th>
            <% if (settles) { %><th data-sort="num" class="num" style="width:130px">Balance</th><% } %>
            <th style="width:120px">Status</th>
            <th class="text-end" style="width:168px"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% if (invoices.length === 0) { %>
            <tr data-static><td colspan="<%= colCount %>">
              <div class="empty-state">
                <i class="icon-file-text"></i>
                <% if (anyFilter) { %>
                  <div class="title">No <%= config.pluralLabel.toLowerCase() %> match these filters</div>
                  <a href="<%= config.basePath %>">Clear filters</a>
                <% } else { %>
                  <div class="title">No <%= config.pluralLabel.toLowerCase() %> yet</div>
                  <% if (!config.returnOf) { %><a href="<%= config.basePath %>/new" class="btn btn-sm btn-primary"><i class="icon-plus"></i> <%= createLabel %></a><% } %>
                <% } %>
              </div>
            </td></tr>
          <% } %>
          <% invoices.forEach(function(inv) { var cancelled = inv.status === 'CANCELLED'; %>
            <tr class="<%= cancelled ? 'row-muted' : '' %>">
              <td class="nowrap" data-sort-value="<%= new Date(inv.invoiceDate).toISOString() %>"><%= fdate(inv.invoiceDate) %></td>
              <td>
                <a href="<%= config.basePath %>/<%= inv.id %>" class="cell-main"><%= inv.invoiceNo %></a>
                <% if (inv.partyInvoiceNo) { %><div class="cell-sub">Bill <%= inv.partyInvoiceNo %></div><% } %>
              </td>
              <td><div class="cell-truncate" title="<%= inv.customer.name %>"><%= inv.customer.name %></div></td>
              <% var div = divs[invoices.indexOf(inv)]; %>
              <% if (showSectionCol) { %>
                <% if (div.unclassified) { %>
                  <%# Not yet known to be a section or a department: shown as typed and marked %>
                  <td data-sort-value="<%= div.unclassified %>"><span class="cell-truncate d-block" title="Saved under the old combined Section / Department label. Edit the invoice to classify it."><%= div.unclassified %></span><span class="badge text-bg-light border fw-normal">Unclassified</span></td>
                <% } else { %>
                  <td><% if (div.section) { %><a href="<%= config.basePath %>?section=<%= encodeURIComponent(div.section) %>" class="text-reset cell-truncate d-block" title="Show all <%= config.pluralLabel.toLowerCase() %> for section <%= div.section %>"><%= div.section %></a><% } else { %><span class="muted">—</span><% } %></td>
                <% } %>
              <% } %>
              <% if (showDepartmentCol) { %>
                <td><% if (div.department) { %><a href="<%= config.basePath %>?department=<%= encodeURIComponent(div.department) %>" class="text-reset cell-truncate d-block" title="Show all <%= config.pluralLabel.toLowerCase() %> for department <%= div.department %>"><%= div.department %></a><% } else { %><span class="muted">—</span><% } %></td>
              <% } %>
              <td class="num"><%= inr(inv.total) %></td>
              <% if (settles) { %><td class="num <%= !cancelled && Number(inv.balance) > 0 ? 'text-danger' : 'muted' %>"><%= inr(inv.balance) %></td><% } %>
              <td>
                <% if (cancelled) { %>
                  <span class="status-badge status-cancelled">Cancelled</span>
                <% } else if (config.docType === 'ESTIMATE') { %>
                  <% if (inv.convertedTo) { %><a href="/invoices/<%= inv.convertedTo.id %>" class="status-badge status-paid" title="Converted to <%= inv.convertedTo.invoiceNo %>">→ <%= inv.convertedTo.invoiceNo %></a><% } else { %><span class="status-badge status-open">Open</span><% } %>
                <% } else { %>
                  <span class="status-badge <%= paymentStatusClass(inv.paymentStatus) %>"><%= paymentStatusLabel(inv.paymentStatus) %></span>
                <% } %>
              </td>
              <td>
                <div class="row-actions">
                  <% if (!cancelled) { %><a href="<%= config.basePath %>/<%= inv.id %>/edit" class="btn btn-sm btn-outline-secondary btn-icon" title="Edit <%= inv.invoiceNo %>" aria-label="Edit <%= inv.invoiceNo %>"><i class="icon-pencil"></i></a><% } %>
                  <a href="<%= config.basePath %>/<%= inv.id %>/pdf" class="btn btn-sm btn-outline-secondary btn-icon" title="Download PDF" aria-label="Download PDF of <%= inv.invoiceNo %>"><i class="icon-download"></i></a>
                  <a href="<%= config.basePath %>/<%= inv.id %>" class="btn btn-sm btn-outline-secondary">Open</a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (invoiceCount > invoices.length) { %>
      <div class="table-pager"><span>Showing the latest <%= invoices.length %> of <%= invoiceCount %>. Narrow the dates to see older ones.</span></div>
    <% } %>
  </div>
</div>
<%- include('../partials/layout-end') %>
