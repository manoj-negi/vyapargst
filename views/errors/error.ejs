<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title><%= status >= 500 ? 'Something went wrong' : 'Cannot do that' %> · The City Cart</title>
</head>
<body>
  <main class="error-page">
    <div class="error-card">
      <div class="error-code"><%= status %></div>
      <h1 class="h5 fw-semibold"><%= status >= 500 ? 'Something went wrong' : 'This action could not be completed' %></h1>
      <p class="text-muted small"><%= message %></p>
      <% if (status >= 500) { %><p class="text-muted small">Nothing was saved by the failed request. Please try again; if it keeps happening, note what you were doing.</p><% } %>
      <div class="d-flex gap-2 justify-content-center"><a href="javascript:history.back()" class="btn btn-outline-secondary">Go back</a><a href="/dashboard" class="btn btn-primary">Dashboard</a></div>
    </div>
  </main>
</body>
</html>
