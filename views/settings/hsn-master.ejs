<%- include('../partials/layout-start', { title: 'HSN Codes', activeNav: 'hsn-master' }) %>
<div class="page" data-list-key="/settings/hsn-master">
<%- include('../partials/page-header', {
  title: 'HSN codes',
  subtitle: 'Suggested on the item form from the item name. The GST rate here is a suggestion; the item’s own GST rate is what invoices use.',
  actions: '<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addHsnModal"><i class="icon-plus"></i> Add HSN code</button>'
}) %>

<div class="panel">
  <form method="GET" action="/settings/hsn-master" class="filter-bar" role="search">
    <div class="f f-search" style="max-width:420px">
      <label class="form-label" for="hq">Search</label>
      <div class="search-input"><i class="icon-search"></i><input type="search" id="hq" name="q" class="form-control form-control-sm" placeholder="HSN code, description or keywords" value="<%= search %>"></div>
    </div>
    <div class="f-actions" style="margin-left:0">
      <button type="submit" class="btn btn-sm btn-primary">Search</button>
      <% if (search) { %><a href="/settings/hsn-master" class="btn btn-sm btn-outline-secondary">Clear</a><% } %>
    </div>
  </form>
  <div class="table-scroll">
    <table class="table table-app">
      <thead>
        <tr><th style="width:110px">HSN</th><th>Description</th><th style="width:240px">Keywords</th><th class="num" style="width:70px">GST</th><th style="width:100px">Status</th><th class="text-end" style="width:220px"><span class="visually-hidden">Actions</span></th></tr>
      </thead>
      <tbody>
        <% if (hsnCodes.length === 0) { %>
          <tr><td colspan="6"><div class="empty-state"><i class="icon-list-tree"></i><div class="title">No HSN codes found</div><% if (search) { %><a href="/settings/hsn-master">Clear search</a><% } %></div></td></tr>
        <% } %>
        <% hsnCodes.forEach(function(h) { %>
          <tr class="<%= h.isActive ? '' : 'row-muted' %>">
            <td class="cell-main"><%= h.hsnCode %></td>
            <td><%= h.description %></td>
            <td><div class="cell-truncate cell-sub" title="<%= h.keywords || '' %>"><%= h.keywords || '—' %></div></td>
            <td class="num"><%= Number(h.gstRate) %>%</td>
            <td><span class="status-badge <%= h.isActive ? 'status-paid' : 'status-cancelled' %>"><%= h.isActive ? 'Active' : 'Disabled' %></span></td>
            <td class="text-end text-nowrap">
              <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editHsnModal"
                      data-id="<%= h.id %>" data-hsn-code="<%= h.hsnCode %>" data-description="<%= h.description %>"
                      data-keywords="<%= h.keywords || '' %>" data-gst-rate="<%= h.gstRate %>">Edit</button>
              <form method="POST" action="/settings/hsn-master/<%= h.id %>/toggle" class="d-inline">
                <input type="hidden" name="returnQ" value="<%= search %>"><input type="hidden" name="returnPage" value="<%= pagination.page %>">
                <button type="submit" class="btn btn-sm btn-outline-secondary"><%= h.isActive ? 'Disable' : 'Enable' %></button>
              </form>
              <form method="POST" action="/settings/hsn-master/<%= h.id %>/delete" class="d-inline"
                    data-confirm="Delete HSN code <%= h.hsnCode %>? This cannot be undone. Items keep the HSN code already saved on them." data-confirm-title="Delete HSN code <%= h.hsnCode %>?" data-confirm-label="Delete HSN code" data-confirm-cancel="Keep it" data-confirm-busy="Deleting…">
                <input type="hidden" name="returnQ" value="<%= search %>"><input type="hidden" name="returnPage" value="<%= pagination.page %>">
                <button type="submit" class="btn btn-sm btn-outline-danger btn-icon" title="Delete <%= h.hsnCode %>" aria-label="Delete <%= h.hsnCode %>"><i class="icon-trash-2"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/pagination', { pagination: pagination, basePath: '/settings/hsn-master' }) %>
</div>
</div>

<div class="modal fade" id="addHsnModal" tabindex="-1" data-bs-backdrop="static" aria-labelledby="addHsnTitle">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/settings/hsn-master" data-dialog-form>
        <div class="modal-header">
          <h2 class="modal-title" id="addHsnTitle">Add HSN code</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger d-none" role="alert" tabindex="-1" data-dialog-error></div>
          <div class="mb-3">
            <label class="form-label">HSN Code</label>
            <input type="text" name="hsnCode" class="form-control" placeholder="e.g. 48025690" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <input type="text" name="description" class="form-control" placeholder="Paper and paperboard..." required>
          </div>
          <div class="mb-3">
            <label class="form-label">Keywords</label>
            <input type="text" name="keywords" class="form-control" placeholder="paper, a4, copier, writing">
            <div class="form-text">Comma-separated words used to match product names.</div>
          </div>
          <div class="mb-3">
            <label class="form-label">GST Rate (%)</label>
            <input type="number" name="gstRate" class="form-control w-qty text-end" step="0.01" min="0" max="100" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save HSN code</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="editHsnModal" tabindex="-1" data-bs-backdrop="static" aria-labelledby="editHsnTitle">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" id="editHsnForm" action="" data-dialog-form>
        <input type="hidden" name="returnQ" value="<%= search %>"><input type="hidden" name="returnPage" value="<%= pagination.page %>">
        <div class="modal-header">
          <h2 class="modal-title" id="editHsnTitle">Edit HSN code</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger d-none" role="alert" tabindex="-1" data-dialog-error></div>
          <div class="mb-3">
            <label class="form-label">HSN Code</label>
            <input type="text" name="hsnCode" id="editHsnCode" class="form-control" placeholder="e.g. 48025690" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <input type="text" name="description" id="editDescription" class="form-control" placeholder="Paper and paperboard..." required>
          </div>
          <div class="mb-3">
            <label class="form-label">Keywords</label>
            <input type="text" name="keywords" id="editKeywords" class="form-control" placeholder="paper, a4, copier, writing">
            <div class="form-text">Comma-separated words used to match product names.</div>
          </div>
          <div class="mb-3">
            <label class="form-label">GST Rate (%)</label>
            <input type="number" name="gstRate" id="editGstRate" class="form-control" step="0.01" min="0" max="100" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.getElementById('editHsnModal').addEventListener('show.bs.modal', function (event) {
    var d = event.relatedTarget.dataset;
    document.getElementById('editHsnForm').action = '/settings/hsn-master/' + d.id;
    document.getElementById('editHsnCode').value = d.hsnCode;
    document.getElementById('editDescription').value = d.description;
    document.getElementById('editKeywords').value = d.keywords;
    document.getElementById('editGstRate').value = d.gstRate;
  });
</script>

<%- include('../partials/layout-end') %>
