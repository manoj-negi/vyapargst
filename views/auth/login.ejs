<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title>Sign in · The City Cart</title>
</head>
<body>
  <main class="auth-wrapper">
    <section class="auth-brand-panel" aria-hidden="true">
      <div class="auth-brand">
        <span class="mark"><i class="icon-receipt"></i></span>
        <div><div class="name">The City Cart</div><div class="sub">Billing &amp; inventory</div></div>
      </div>
      <div>
        <h2>GST billing, stock and payments, all in one place.</h2>
        <p>Raise invoices in seconds, keep stock and party balances right, and have your GST figures ready when you need them.</p>
        <div class="auth-feature"><i class="icon-file-text"></i> Invoices, estimates, returns and purchase bills</div>
        <div class="auth-feature"><i class="icon-package"></i> Stock that updates itself with every bill</div>
        <div class="auth-feature"><i class="icon-chart-column"></i> Party statements and GST summaries on demand</div>
      </div>
      <div class="small" style="color:#d9c3b2">Your data stays on this computer's database.</div>
    </section>
    <section class="auth-form-panel">
      <div class="auth-card">
        <div class="auth-brand mb-4 d-xl-none">
          <span class="mark"><i class="icon-receipt"></i></span>
          <div><div class="name">The City Cart</div><div class="sub text-muted">Billing &amp; inventory</div></div>
        </div>
        <h1 class="h4 fw-bold mb-1">Welcome back</h1>
        <p class="small text-muted mb-4">Sign in with your business account.</p>

        <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>

        <form method="POST" action="/login" id="loginForm">
          <div class="mb-3">
            <label class="form-label" for="email">Email</label>
            <div class="search-input"><i class="icon-mail"></i><input type="email" id="email" name="email" class="form-control" required autofocus autocomplete="username" placeholder="you@business.com" value="<%= typeof email !== 'undefined' && email ? email : '' %>"></div>
          </div>
          <div class="mb-4">
            <label class="form-label" for="password">Password</label>
            <div class="search-input"><i class="icon-lock"></i><input type="password" id="password" name="password" class="form-control" required autocomplete="current-password"></div>
          </div>
          <button type="submit" class="btn btn-primary w-100" id="loginBtn">Sign in <i class="icon-arrow-right"></i></button>
        </form>
      </div>
    </section>
  </main>
  <script>
    document.getElementById('loginForm').addEventListener('submit', function () {
      var b = document.getElementById('loginBtn');
      setTimeout(function () { b.disabled = true; b.innerHTML = '<span class="spinner-border" aria-hidden="true"></span> Signing in…'; }, 0);
    });
  </script>
</body>
</html>
