<%- include('../partials/layout-start', { title: 'Items', activeNav: 'products' }) %>
<% var anyFilter = filters.q || filters.category || filters.gstRate || filters.stockStatus; %>
<div class="page" data-list-key="/products">
  <%- include('../partials/page-header', {
    title: 'Items',
    subtitle: 'Products and services you sell or buy. Stock updates automatically from sales, purchases and returns.',
    actions: '<a href="/products/new" class="btn btn-primary"><i class="icon-plus"></i> Add item</a>'
  }) %>

  <div class="panel">
    <form method="GET" action="/products" class="filter-bar" id="filterForm" role="search">
      <input type="hidden" name="type" value="<%= filters.type %>">
      <div class="chips align-self-end me-2" role="tablist" aria-label="Item type">
        <a class="chip <%= filters.type !== 'service' ? 'active' : '' %>" href="/products?type=product" role="tab" aria-selected="<%= filters.type !== 'service' %>"><i class="icon-package"></i> Products</a>
        <a class="chip <%= filters.type === 'service' ? 'active' : '' %>" href="/products?type=service" role="tab" aria-selected="<%= filters.type === 'service' %>"><i class="icon-wrench"></i> Services</a>
      </div>
      <div class="f f-search">
        <label class="form-label" for="fq">Search</label>
        <div class="search-input"><i class="icon-search"></i><input type="search" id="fq" name="q" class="form-control form-control-sm" placeholder="Name, code, HSN or barcode" value="<%= filters.q %>" autocomplete="off"></div>
      </div>
      <div class="f f-select-lg">
        <label class="form-label" for="fcat">Category</label>
        <select id="fcat" name="category" class="form-select form-select-sm">
          <option value="">All categories</option>
          <% categories.forEach(function(c) { %><option value="<%= c.id %>" <%= filters.category === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
        </select>
      </div>
      <div class="f f-select">
        <label class="form-label" for="fgst">GST rate</label>
        <select id="fgst" name="gstRate" class="form-select form-select-sm">
          <option value="">All rates</option>
          <% taxes.forEach(function(t) { %><option value="<%= t.id %>" <%= filters.gstRate === t.id ? 'selected' : '' %>><%= t.rate %>%</option><% }) %>
        </select>
      </div>
      <% if (filters.type !== 'service') { %>
      <div class="f f-select">
        <label class="form-label" for="fstock">Stock</label>
        <select id="fstock" name="stockStatus" class="form-select form-select-sm">
          <option value="">Any</option>
          <option value="low" <%= filters.stockStatus === 'low' ? 'selected' : '' %>>Low stock</option>
          <option value="out" <%= filters.stockStatus === 'out' ? 'selected' : '' %>>Out of stock</option>
        </select>
      </div>
      <% } %>
      <div class="f-actions">
        <a href="/products?type=<%= filters.type %>" class="btn btn-sm btn-outline-secondary" id="clearFilters" <%= anyFilter ? '' : 'hidden' %>>Clear</a>
        <noscript><button type="submit" class="btn btn-sm btn-primary">Apply</button></noscript>
      </div>
    </form>

    <div class="table-scroll sticky" id="resultsWrap" aria-live="polite">
      <table class="table table-app" id="itemsTable" data-sortable data-page-size="50">
        <thead>
          <tr>
            <th data-sort="text">Item</th>
            <th data-sort="text" style="width:120px">Code</th>
            <th data-sort="text" style="width:100px">HSN</th>
            <th data-sort="text" style="width:150px">Category</th>
            <th data-sort="num" class="num" style="width:120px">Sale price</th>
            <th data-sort="num" class="num" style="width:120px">Purchase</th>
            <th data-sort="num" class="num" style="width:70px">GST</th>
            <% if (filters.type !== 'service') { %><th data-sort="num" class="num" style="width:120px">Stock</th><% } %>
            <th class="text-end" style="width:110px"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% if (products.length === 0) { %>
            <tr data-static><td colspan="9">
              <div class="empty-state">
                <i class="icon-package"></i>
                <% if (anyFilter) { %>
                  <div class="title">No items match these filters</div>
                  <a href="/products?type=<%= filters.type %>">Clear filters</a>
                <% } else { %>
                  <div class="title">No <%= filters.type === 'service' ? 'services' : 'products' %> yet</div>
                  <a href="/products/new" class="btn btn-sm btn-primary"><i class="icon-plus"></i> Add item</a>
                <% } %>
              </div>
            </td></tr>
          <% } %>
          <% products.forEach(function(p) { var stock = Number(p.currentStock); %>
            <tr>
              <td>
                <a href="/products/<%= p.id %>/edit" class="cell-main d-block cell-truncate" title="<%= p.name %>"><%= p.name %></a>
                <% if (p.unit) { %><div class="cell-sub"><%= p.unit.name %></div><% } %>
              </td>
              <td class="muted"><%= p.itemCode || '—' %></td>
              <td class="muted"><%= p.hsnCode || '—' %></td>
              <td><div class="cell-truncate" title="<%= p.category ? p.category.name : '' %>"><%= p.category ? p.category.name : '—' %></div></td>
              <td class="num" data-sort-value="<%= Number(p.salePrice) %>"><%= inr(p.salePrice) %><div class="cell-sub"><%= p.priceType === 'INCLUSIVE' ? 'incl. tax' : 'excl. tax' %></div></td>
              <td class="num" data-sort-value="<%= p.purchasePrice ? Number(p.purchasePrice) : 0 %>"><%= p.purchasePrice ? inr(p.purchasePrice) : '—' %></td>
              <td class="num" data-sort-value="<%= p.tax ? Number(p.tax.rate) : -1 %>"><%= p.tax ? Number(p.tax.rate) + '%' : 'Exempt' %></td>
              <% if (filters.type !== 'service') { %>
              <td class="num" data-sort-value="<%= stock %>">
                <span class="<%= stock <= 0 ? 'text-danger fw-semibold' : (stock <= Number(p.minStock) ? 'text-warning fw-semibold' : '') %>"><%= qty(stock) %></span>
                <% if (stock <= 0) { %><div class="cell-sub text-danger">Out of stock</div><% } else if (stock <= Number(p.minStock)) { %><div class="cell-sub text-warning">Low</div><% } %>
              </td>
              <% } %>
              <td>
                <div class="row-actions">
                  <a href="/products/<%= p.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                  <form method="POST" action="/products/<%= p.id %>/delete" class="m-0" data-confirm="Remove “<%= p.name %>” from your item list? It stays on past invoices and its history is kept." data-confirm-title="Remove item?" data-confirm-label="Remove item" data-confirm-cancel="Keep item" data-confirm-busy="Removing…">
                    <button type="submit" class="btn btn-sm btn-outline-danger btn-icon" title="Remove <%= p.name %>" aria-label="Remove <%= p.name %>"><i class="icon-trash-2"></i></button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  // Live filtering: re-fetch this page with the new query and swap in the table body.
  (function () {
    var form = document.getElementById('filterForm');
    var table = document.getElementById('itemsTable');
    var clear = document.getElementById('clearFilters');
    if (!form || !table) return;
    var timer, controller;

    async function refresh() {
      if (controller) controller.abort();
      controller = new AbortController();
      var url = new URL(form.action, location.origin);
      new FormData(form).forEach(function (v, k) { if (v) url.searchParams.set(k, v); });
      table.closest('.table-scroll').style.opacity = '0.6';
      try {
        var res = await fetch(url, { signal: controller.signal });
        if (!res.ok) return;
        var doc = new DOMParser().parseFromString(await res.text(), 'text/html');
        var fresh = doc.querySelector('#itemsTable tbody');
        if (fresh) table.tBodies[0].innerHTML = fresh.innerHTML;
        table.dispatchEvent(new Event('rows:changed'));
        history.replaceState(null, '', url);
        try { sessionStorage.setItem('list:/products', url.pathname + url.search); } catch (e) {}
        var active = ['q', 'category', 'gstRate', 'stockStatus'].some(function (k) { return url.searchParams.get(k); });
        if (clear) clear.hidden = !active;
      } catch (err) {
        if (err.name !== 'AbortError') console.error('Filter failed', err);
      } finally {
        table.closest('.table-scroll').style.opacity = '';
      }
    }

    form.addEventListener('submit', function (e) { e.preventDefault(); refresh(); });
    form.querySelectorAll('input[type=search]').forEach(function (input) {
      input.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(refresh, 250); });
    });
    form.querySelectorAll('select').forEach(function (sel) { sel.addEventListener('change', refresh); });
  })();
</script>
<%- include('../partials/layout-end') %>
