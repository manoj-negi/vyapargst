<header class="topbar">
  <button class="topbar-menu-btn" id="mobileMenuToggle" type="button" aria-label="Open menu">
    <i class="icon-menu"></i>
  </button>
  <h1 class="topbar-title"><%= pageTitle %></h1>
  <div class="topbar-user">
    <span class="topbar-user-name"><i class="icon-user"></i> <%= typeof userName !== 'undefined' ? userName : '' %></span>
    <form action="/logout" method="POST" class="m-0">
      <button type="submit" class="btn btn-sm btn-outline-danger"><i class="icon-log-out"></i> Logout</button>
    </form>
  </div>
</header>
