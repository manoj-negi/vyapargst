<% var isEdit = !!(customer && customer.id); var isSupplier = customer && customer.partyType === 'SUPPLIER'; %>
<%- include('../partials/layout-start', { title: isEdit ? 'Edit ' + customer.name : 'Add Party', activeNav: isSupplier ? 'suppliers' : 'customers' }) %>
<div class="page page-narrow">
  <%- include('../partials/page-header', {
    title: isEdit ? 'Edit ' + customer.name : (isSupplier ? 'Add supplier' : 'Add party'),
    subtitle: 'Customers and suppliers share one list; a party can be both.',
    back: isEdit ? { href: '/customers/' + customer.id, label: 'Statement' } : { href: '/customers', label: 'Parties', key: '/customers' }
  }) %>
  <%- include('../partials/form-errors', { errors: errors }) %>
  <form method="POST" action="<%= isEdit ? '/customers/' + customer.id : '/customers' %>" data-dirty-guard novalidate>
    <div class="panel">
      <%- include('_fields', { customer: customer, states: states, defaultState: typeof business !== 'undefined' && business ? business.state : '' }) %>
    </div>
    <div class="action-bar">
      <span class="hint"><span class="req">*</span> Required</span>
      <div class="btns">
        <a href="<%= isEdit ? '/customers/' + customer.id : '/customers' %>" class="btn btn-outline-secondary" <%- isEdit ? '' : 'data-back-to="/customers"' %>>Cancel</a>
        <button type="submit" class="btn btn-primary" data-shortcut-save><i class="icon-check"></i> <%= isEdit ? 'Save changes' : 'Save party' %></button>
      </div>
    </div>
  </form>
</div>
<%- include('../partials/layout-end') %>
