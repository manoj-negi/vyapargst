<div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer" style="z-index: 1080">
  <% if (typeof flash !== 'undefined' && flash && flash.message) { %>
    <div class="toast align-items-center text-bg-<%= flash.type || 'success' %> border-0 show" role="alert" data-autohide-toast>
      <div class="d-flex">
        <div class="toast-body"><%= flash.message %></div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
      </div>
    </div>
  <% } %>
</div>
