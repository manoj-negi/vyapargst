<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title>Page not found · The City Cart</title>
</head>
<body>
  <main class="error-page">
    <div class="error-card">
      <div class="error-code">404</div>
      <h1 class="h5 fw-semibold">Page not found</h1>
      <p class="text-muted small">There is nothing at <code><%= path %></code>. The link may be old or mistyped.</p>
      <div class="d-flex gap-2 justify-content-center"><a href="javascript:history.back()" class="btn btn-outline-secondary">Go back</a><a href="/dashboard" class="btn btn-primary">Dashboard</a></div>
    </div>
  </main>
</body>
</html>
