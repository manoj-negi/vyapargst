<%#
  Party fields, shared by the Add/Edit Party page and the quick "New customer/supplier" dialog on
  invoice and purchase forms (quick: true shows contact, GST and address only).
%>
<%
  var c = customer || {};
  var isQuick = typeof quick !== 'undefined' && quick;
  var fe = typeof fieldErrors !== 'undefined' && fieldErrors ? fieldErrors : {};
  var ob = c.openingBalance !== undefined && c.openingBalance !== null ? Number(c.openingBalance) : 0;
  if (c.openingBalanceAmount !== undefined) ob = Number(c.openingBalanceAmount || 0) * (c.openingBalanceSide === 'PAY' ? -1 : 1);
  var idp = isQuick ? 'q-' : 'pf-';
  function v(f) { return c[f] != null ? c[f] : ''; }
  var stateValue = c.state || (typeof defaultState !== 'undefined' ? defaultState : '');
%>
<% if (!isQuick) { %><div class="form-section"><div class="form-section-head"><h2 class="form-section-title">Party details</h2></div><% } %>
<div class="fgrid">
  <div class="<%= isQuick ? 's8' : 's6' %>">
    <label class="form-label" for="<%= idp %>name">Name <span class="req">*</span></label>
    <input type="text" id="<%= idp %>name" name="name" class="form-control<%= invalid(fe, 'name') %>" required maxlength="150" value="<%= v('name') %>" <%= isQuick ? '' : 'autofocus' %>>
    <%- fieldError(fe, 'name') %>
  </div>
  <% if (!isQuick) { %>
  <div class="s3">
    <label class="form-label" for="<%= idp %>partyType">Party type</label>
    <select id="<%= idp %>partyType" name="partyType" class="form-select">
      <option value="CUSTOMER" <%= (!c.partyType || c.partyType === 'CUSTOMER') ? 'selected' : '' %>>Customer</option>
      <option value="SUPPLIER" <%= c.partyType === 'SUPPLIER' ? 'selected' : '' %>>Supplier</option>
      <option value="BOTH" <%= c.partyType === 'BOTH' ? 'selected' : '' %>>Customer &amp; supplier</option>
    </select>
  </div>
  <% } %>
  <div class="<%= isQuick ? 's4' : 's3' %>">
    <label class="form-label" for="<%= idp %>customerType">GST type</label>
    <select id="<%= idp %>customerType" name="customerType" class="form-select">
      <option value="CONSUMER" <%= (!c.customerType || c.customerType === 'CONSUMER') ? 'selected' : '' %>>Consumer</option>
      <option value="REGISTERED" <%= c.customerType === 'REGISTERED' ? 'selected' : '' %>>Registered</option>
      <option value="UNREGISTERED" <%= c.customerType === 'UNREGISTERED' ? 'selected' : '' %>>Unregistered</option>
    </select>
  </div>
  <div class="s4">
    <label class="form-label" for="<%= idp %>phone">Phone</label>
    <input type="tel" id="<%= idp %>phone" name="phone" class="form-control<%= invalid(fe, 'phone') %>" placeholder="9876543210" maxlength="15" inputmode="tel" value="<%= v('phone') %>">
    <%- fieldError(fe, 'phone') %>
  </div>
  <div class="s4">
    <label class="form-label" for="<%= idp %>email">Email</label>
    <input type="email" id="<%= idp %>email" name="email" class="form-control<%= invalid(fe, 'email') %>" maxlength="120" value="<%= v('email') %>">
    <%- fieldError(fe, 'email') %>
  </div>
  <div class="s4">
    <label class="form-label" for="<%= idp %>gstin">GSTIN</label>
    <input type="text" id="<%= idp %>gstin" name="gstin" class="form-control text-uppercase<%= invalid(fe, 'gstin') %>" maxlength="15" placeholder="05ABCDE1234F1Z5" value="<%= v('gstin') %>">
    <%- fieldError(fe, 'gstin') %>
  </div>
  <div class="s3">
    <label class="form-label" for="<%= idp %>pan">PAN</label>
    <input type="text" id="<%= idp %>pan" name="pan" class="form-control text-uppercase<%= invalid(fe, 'pan') %>" maxlength="10" value="<%= v('pan') %>">
    <%- fieldError(fe, 'pan') %>
  </div>
  <div class="s3">
    <label class="form-label" for="<%= idp %>department">Department</label>
    <input type="text" id="<%= idp %>department" name="department" class="form-control" maxlength="80" value="<%= v('department') %>">
  </div>
  <div class="s3">
    <label class="form-label" for="<%= idp %>section">Section</label>
    <input type="text" id="<%= idp %>section" name="section" class="form-control" maxlength="80" value="<%= v('section') %>">
  </div>
</div>
<% if (!isQuick) { %></div><div class="form-section"><div class="form-section-head"><h2 class="form-section-title">Address</h2><div class="form-section-desc">The state decides CGST + SGST (same state) or IGST (other state).</div></div><% } else { %><div class="fgrid mt-3"><% } %>
<% if (!isQuick) { %><div class="fgrid"><% } %>
  <div class="s6">
    <label class="form-label" for="<%= idp %>billingAddress">Billing address</label>
    <textarea id="<%= idp %>billingAddress" name="billingAddress" class="form-control" rows="2" maxlength="500"><%= v('billingAddress') %></textarea>
  </div>
  <div class="s6">
    <label class="form-label" for="<%= idp %>shippingAddress">Shipping address <span class="text-muted fw-normal">(if different)</span></label>
    <textarea id="<%= idp %>shippingAddress" name="shippingAddress" class="form-control" rows="2" maxlength="500"><%= v('shippingAddress') %></textarea>
  </div>
  <div class="s4">
    <label class="form-label" for="<%= idp %>state">State <span class="req">*</span></label>
    <select id="<%= idp %>state" name="state" class="form-select<%= invalid(fe, 'state') %>" required>
      <option value="">Select state</option>
      <% states.forEach(function(s) { %><option value="<%= s %>" <%= stateValue === s ? 'selected' : '' %>><%= s %></option><% }) %>
    </select>
    <%- fieldError(fe, 'state') %>
  </div>
  <div class="s2">
    <label class="form-label" for="<%= idp %>pincode">PIN code</label>
    <input type="text" id="<%= idp %>pincode" name="pincode" class="form-control" maxlength="6" inputmode="numeric" value="<%= v('pincode') %>">
  </div>
</div>
<% if (!isQuick) { %></div>
<div class="form-section">
  <div class="form-section-head"><h2 class="form-section-title">Opening balance</h2><div class="form-section-desc">What was owed on the day you started using the app.</div></div>
  <div class="fgrid">
    <div class="s3">
      <label class="form-label" for="pf-ob">Amount</label>
      <div class="price-pair"><span class="rupee">₹</span><input type="number" id="pf-ob" name="openingBalanceAmount" class="form-control<%= invalid(fe, 'openingBalanceAmount') %>" min="0" step="0.01" value="<%= Math.abs(ob) %>"></div>
      <%- fieldError(fe, 'openingBalanceAmount') %>
    </div>
    <div class="s4">
      <label class="form-label" for="pf-obside">Balance is</label>
      <select id="pf-obside" name="openingBalanceSide" class="form-select">
        <option value="RECEIVE" <%= ob >= 0 ? 'selected' : '' %>>To receive (party owes you)</option>
        <option value="PAY" <%= ob < 0 ? 'selected' : '' %>>To pay (you owe party)</option>
      </select>
    </div>
    <div class="s3">
      <label class="form-label" for="pf-obdate">As of date</label>
      <input type="date" id="pf-obdate" name="openingBalanceDate" class="form-control" value="<%= c.openingBalanceDate ? new Date(c.openingBalanceDate).toISOString().slice(0,10) : '' %>">
    </div>
  </div>
</div>
<% } %>
