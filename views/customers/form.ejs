<%- include('../partials/layout-start', { title: customer && customer.id ? 'Edit Customer' : 'Add Customer', activeNav: 'customers' }) %>

<div class="card p-4" style="max-width: 720px;">
  <h5 class="fw-bold mb-3"><%= customer && customer.id ? 'Edit Customer' : 'Add Customer' %></h5>

  <% if (errors && errors.length) { %>
    <div class="alert alert-danger py-2 small">
      <ul class="mb-0 ps-3"><% errors.forEach(function(e) { %><li><%= e %></li><% }) %></ul>
    </div>
  <% } %>

  <form method="POST" action="<%= customer && customer.id ? '/customers/' + customer.id : '/customers' %>">
    <%- include('_fields', { customer: customer, states: states, defaultState: '' }) %>

    <div class="mt-4 d-flex gap-2">
      <button type="submit" class="btn btn-primary-app px-4" data-shortcut-save>Save Customer</button>
      <a href="/customers" class="btn btn-outline-secondary px-4">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/layout-end') %>
