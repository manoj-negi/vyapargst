<%- include('../partials/layout-start', { title: 'Products', activeNav: 'products' }) %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <ul class="nav nav-pills">
    <li class="nav-item">
      <a class="nav-link <%= filters.type === 'product' ? 'active' : '' %>" href="/products?type=product">Products</a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= filters.type === 'service' ? 'active' : '' %>" href="/products?type=service">Services</a>
    </li>
  </ul>
  <div class="d-flex gap-2">
    <a href="/invoices/new" class="btn btn-outline-primary"><i class="icon-plus"></i> Add Sale</a>
    <a href="/products/new" class="btn btn-accent"><i class="icon-plus"></i> Add Item</a>
  </div>
</div>

<div class="card p-3 mb-3">
  <form method="GET" action="/products" class="row g-2 align-items-end" id="filterForm">
    <input type="hidden" name="type" value="<%= filters.type %>">
    <div class="col-md-4">
      <label class="form-label small fw-semibold mb-1">Search</label>
      <input type="text" name="q" class="form-control form-control-sm" placeholder="Name, item code, HSN or barcode" value="<%= filters.q %>">
    </div>
    <div class="col-md-3">
      <label class="form-label small fw-semibold mb-1">Category</label>
      <select name="category" class="form-select form-select-sm">
        <option value="">All Categories</option>
        <% categories.forEach(function(c) { %>
          <option value="<%= c.id %>" <%= filters.category === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-2">
      <label class="form-label small fw-semibold mb-1">GST Rate</label>
      <select name="gstRate" class="form-select form-select-sm">
        <option value="">All Rates</option>
        <% taxes.forEach(function(t) { %>
          <option value="<%= t.id %>" <%= filters.gstRate === t.id ? 'selected' : '' %>><%= t.rate %>%</option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-2">
      <label class="form-label small fw-semibold mb-1">Stock Status</label>
      <select name="stockStatus" class="form-select form-select-sm">
        <option value="">All</option>
        <option value="low" <%= filters.stockStatus === 'low' ? 'selected' : '' %>>Low Stock</option>
        <option value="out" <%= filters.stockStatus === 'out' ? 'selected' : '' %>>Out of Stock</option>
      </select>
    </div>
    <div class="col-md-1">
      <button type="submit" class="btn btn-sm btn-primary-app w-100">Filter</button>
    </div>
  </form>
</div>

<div class="card">
  <div class="table-scroll">
    <table class="table table-app mb-0">
      <thead>
        <tr>
          <th>Item Name</th><th>Item Code</th><th>HSN</th><th>Category</th><th>Unit</th>
          <th>Sale Price</th><th>Purchase Price</th><th>GST Rate</th><th>Stock</th><th>Status</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% if (products.length === 0) { %>
          <tr><td colspan="11">
            <div class="empty-state">
              <i class="icon-package"></i>
              No items found. <a href="/products/new">Add your first item</a>.
            </div>
          </td></tr>
        <% } %>
        <% products.forEach(function(p) { %>
          <tr>
            <td><a href="/products/<%= p.id %>/edit" class="fw-semibold"><%= p.name %></a></td>
            <td><%= p.itemCode || '-' %></td>
            <td><%= p.hsnCode || '-' %></td>
            <td><%= p.category ? p.category.name : '-' %></td>
            <td><%= p.unit ? p.unit.name : '-' %></td>
            <td>₹<%= Number(p.salePrice).toFixed(2) %></td>
            <td><%= p.purchasePrice ? '₹' + Number(p.purchasePrice).toFixed(2) : '-' %></td>
            <td><%= p.tax ? p.tax.rate + '%' : '-' %></td>
            <td>
              <%= Number(p.currentStock) %>
              <% if (Number(p.currentStock) <= 0) { %>
                <span class="status-badge status-unpaid">Out</span>
              <% } else if (Number(p.currentStock) <= Number(p.minStock)) { %>
                <span class="status-badge status-partial">Low</span>
              <% } %>
            </td>
            <td>
              <span class="status-badge <%= p.isActive ? 'status-paid' : 'status-unpaid' %>"><%= p.isActive ? 'Active' : 'Inactive' %></span>
            </td>
            <td class="d-flex gap-1">
              <a href="/products/<%= p.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
              <form method="POST" action="/products/<%= p.id %>/delete" onsubmit="return confirm('Are you sure you want to delete this item?');" style="margin:0;">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
  (function() {
    const filterForm = document.getElementById('filterForm');
    const tableBody = document.querySelector('.table-app tbody');
    let debounceTimer;
    let currentRequestId = 0;

    filterForm.addEventListener('input', function() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        const requestId = ++currentRequestId;
        const url = new URL(filterForm.action, window.location.origin);
        const params = new URLSearchParams(new FormData(filterForm));
        url.search = params.toString();

        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
          .then(res => res.text())
          .then(html => {
            if (requestId !== currentRequestId) return; // Prevent older response from replacing newer one
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const newTbody = doc.querySelector('.table-app tbody');
            if (newTbody && tableBody) {
              tableBody.innerHTML = newTbody.innerHTML;
            }
            window.history.replaceState({}, '', url);
          })
          .catch(err => console.error("Filter error:", err));
      }, 250);
    });
  })();
</script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterForm = document.getElementById('filterForm');
    const tbody = document.querySelector('.table-app tbody');
    if (!filterForm || !tbody) return;

    let debounceTimer;
    let latestAbortController;

    const fetchResults = async () => {
      if (latestAbortController) latestAbortController.abort();
      latestAbortController = new AbortController();

      const url = new URL(filterForm.action, window.location.origin);
      const formData = new FormData(filterForm);
      for (const [key, value] of formData.entries()) {
        url.searchParams.append(key, value);
      }

      try {
        const response = await fetch(url, { signal: latestAbortController.signal });
        if (!response.ok) return;
        const html = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const newTbody = doc.querySelector('.table-app tbody');
        if (newTbody) {
          tbody.innerHTML = newTbody.innerHTML;
        }
        
        window.history.replaceState({}, '', url);
      } catch (err) {
        if (err.name !== 'AbortError') console.error('Filter fetch error:', err);
      }
    };

    filterForm.querySelectorAll('input, select').forEach(input => {
      if (input.type === 'text') {
        input.addEventListener('input', () => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(fetchResults, 250);
        });
      } else {
        input.addEventListener('change', fetchResults);
      }
    });
    
    // Hide the filter button since filtering is now automatic
    const filterBtn = filterForm.querySelector('button[type="submit"]');
    if (filterBtn) filterBtn.parentElement.style.display = 'none';
  });
</script>

<%- include('../partials/layout-end') %>
