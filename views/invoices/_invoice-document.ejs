<style>
  .invoice-doc { font-family: "Segoe UI", Roboto, "DejaVu Sans", "Noto Sans", Arial, sans-serif; color: #2f3542; font-size: 12px; background: #fff; padding: 24px; max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; min-height: 1160px; }
  .invoice-doc * { box-sizing: border-box; }
  .invoice-doc .doc-title { text-align: center; font-size: 24px; font-weight: 700; margin: 0 0 14px; }
  .invoice-doc .main-frame { border: 1.5px solid #3b4253; flex: 1; display: flex; flex-direction: column; }
  .invoice-doc .main-frame table { border-left: none; border-right: none; margin: 0; }
  .invoice-doc .main-frame table tr td:first-child, .invoice-doc .main-frame table tr th:first-child { border-left: none; }
  .invoice-doc .main-frame table tr td:last-child, .invoice-doc .main-frame table tr th:last-child { border-right: none; }
  .invoice-doc table { width: 100%; border-collapse: collapse; }
  .invoice-doc td, .invoice-doc th { border: 1px solid #3b4253; padding: 4px 6px; vertical-align: top; }
  .invoice-doc th { text-align: left; font-weight: 700; }
  .invoice-doc .num { text-align: right; white-space: nowrap; }
  .invoice-doc .center { text-align: center; }
  .invoice-doc .shade { background: #f3f4f6; font-weight: 700; }
  .invoice-doc .muted { color: #4b5563; }

  .invoice-doc .biz { display: flex; gap: 16px; padding: 12px 14px; border-bottom: 1.5px solid #3b4253; }
  .invoice-doc .biz-logo { width: 110px; height: 110px; object-fit: contain; }
  .invoice-doc .biz-name { font-size: 20px; font-weight: 700; margin-bottom: 4px; text-transform: uppercase; }
  .invoice-doc .biz-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 24px; margin-top: 4px; }

  .invoice-doc .meta td { border-top: none; }
  .invoice-doc .meta tr:first-child td { border-top: none; }
  .invoice-doc .meta .label-row td { background: #f3f4f6; font-weight: 700; }
  .invoice-doc .customer-name { font-weight: 700; margin-bottom: 2px; }
  .invoice-doc .bill-bottom { display: flex; gap: 12px; margin-top: 10px; }
  .invoice-doc .bill-bottom > div { flex: 1; }

  .invoice-doc .items-wrapper { flex: 1; display: flex; flex-direction: column; }
  .invoice-doc .items { width: 100%; flex: 1; border-collapse: collapse; }
  .invoice-doc .items tbody td { border-top: none; border-bottom: none; }
  .invoice-doc .items th { background: #f3f4f6; border-bottom: 1px solid #3b4253; }
  .invoice-doc .items .total-row td { font-weight: 700; border-top: 1px solid #3b4253; border-bottom: 1px solid #3b4253; }

  .invoice-doc .summary { border-top: none; }
  .invoice-doc .summary > tbody > tr > td { padding: 0; border: none; }
  .invoice-doc .summary .tax-table th, .invoice-doc .summary .tax-table td { text-align: right; }
  .invoice-doc .summary .tax-table th:first-child, .invoice-doc .summary .tax-table td:first-child { text-align: left; }
  .invoice-doc .summary .tax-table th { text-align: center; background: #f3f4f6; }
  .invoice-doc .totals td { border-left: none; border-right: none; }
  .invoice-doc .totals .sep { width: 16px; text-align: center; }

  .invoice-doc .footer { border-top: 1px solid #3b4253; }
  .invoice-doc .sign-box { width: 140px; height: 50px; border: 1px solid #9ca3af; margin: 24px auto 4px; }
</style>

<% var intra = invoice.taxType === 'INTRA_STATE'; %>
<div class="invoice-doc">
  <div class="doc-title">Tax Invoice</div>

  <div class="main-frame">
    <div class="biz">
      <% if (business.logoPath) { %><img src="<%= business.logoPath %>" class="biz-logo" alt="Logo"><% } %>
      <div style="flex:1;">
        <div class="biz-name"><%= business.name %></div>
        <div><%= [business.address, business.city].filter(Boolean).join(' ') %><%= business.pincode ? ' - ' + business.pincode : '' %></div>
        <div class="biz-grid">
          <% if (business.phone) { %><div>Phone: <strong><%= business.phone %></strong></div><% } %>
          <% if (business.email) { %><div>Email: <strong><%= business.email %></strong></div><% } %>
          <% if (business.gstin) { %><div>GSTIN: <strong><%= business.gstin %></strong></div><% } %>
          <div>State: <strong><%= stateWithCode(business.state) %></strong></div>
        </div>
      </div>
    </div>

    <table class="meta">
      <tr class="label-row">
        <td style="width:50%; border-left:none;">Bill To:</td>
        <td colspan="2" style="border-right:none;">Invoice Details:</td>
      </tr>
      <tr>
        <td style="border-left:none; border-bottom:none;">
          <div class="customer-name"><%= customer.name %></div>
          <% if (customer.billingAddress) { %><div class="muted" style="white-space:pre-line;"><%= customer.billingAddress %></div><% } %>
          <div class="muted"><%= customer.state %><%= customer.pincode ? '-' + customer.pincode : '' %></div>
          <div class="muted">India</div>
          <% if (customer.phone) { %><div class="muted">Contact No.: <%= customer.phone %></div><% } %>
          <div class="bill-bottom">
            <div>State: <strong><%= stateWithCode(customer.state) %></strong></div>
            <% if (customer.gstin) { %><div>GSTIN Number:<br><strong><%= customer.gstin %></strong></div><% } %>
          </div>
        </td>
        <td style="width:25%; border-bottom:none;">
          <div>No: <strong><%= invoice.invoiceNo %></strong></div>
          <div>Date: <strong><%= formatDate(invoice.invoiceDate) %></strong></div>
          <% if (invoice.dueDate) { %><div>Due Date: <strong><%= formatDate(invoice.dueDate) %></strong></div><% } %>
          <div>Place of Supply: <strong style="white-space:nowrap;"><%= stateWithCode(invoice.placeOfSupply) %></strong></div>
        </td>
        <td style="width:25%; border-right:none; border-bottom:none;">
          <% if (customer.section) { %><div>SECTION: <strong><%= customer.section %></strong></div><% } %>
          <% if (customer.department) { %><div>DEPARTMENT: <strong><%= customer.department %></strong></div><% } %>
        </td>
      </tr>
    </table>
  <div class="items-wrapper">
  <table class="items">
    <thead>
      <tr>
        <th style="width:28px;">#</th>
        <th>Item name</th>
        <th style="white-space:nowrap;">HSN/ SAC</th>
        <th class="num">Quantity</th>
        <th class="num">Unit</th>
        <th class="num">Price/Unit(₹)</th>
        <% if (hasLineDiscount) { %><th class="num">Discount(₹)</th><% } %>
        <th class="num">GST(₹)</th>
        <th class="num">Amount(₹)</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(function(item, i) { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><strong><%= item.productName %></strong></td>
          <td><%= item.hsn || '' %></td>
          <td class="num"><%= Number(item.quantity) %></td>
          <td class="num"><%= item.unit || '' %></td>
          <td class="num"><%= formatMoney(item.rate) %></td>
          <% if (hasLineDiscount) { %>
            <td class="num">
              <% if (Number(item.discount) > 0) { %>
                <% if (item.discountType === 'PERCENTAGE') { %>
                  ₹ <%= formatMoney(Number(item.quantity) * Number(item.rate) * Number(item.discount) / 100) %> (<%= Number(item.discount) %>%)
                <% } else { %>
                  ₹ <%= formatMoney(item.discount) %>
                <% } %>
              <% } else { %>
                ₹ 0.00 (0%)
              <% } %>
            </td>
          <% } %>
          <td class="num">₹ <%= formatMoney(Number(item.cgst) + Number(item.sgst) + Number(item.igst)) %><br>(<%= Number(item.taxRate).toFixed(1) %>%)</td>
          <td class="num">₹ <%= formatMoney(item.finalAmount) %></td>
        </tr>
      <% }) %>
      <tr style="height: 100%;">
        <td></td><td></td><td></td><td></td><td></td><td></td>
        <% if (hasLineDiscount) { %><td></td><% } %>
        <td></td><td></td>
      </tr>
      <tr class="total-row">
        <td></td>
        <td>Total</td>
        <td></td>
        <td class="num"><%= itemTotals.quantity %></td>
        <td></td>
        <td></td>
        <% if (hasLineDiscount) { %><td></td><% } %>
        <td class="num">₹ <%= formatMoney(itemTotals.gst) %></td>
        <td class="num">₹ <%= formatMoney(itemTotals.amount) %></td>
      </tr>
    </tbody>
  </table>
  </div>

  <table class="summary" style="border-top:none;">
    <tr>
      <td style="width:68%; border-right:1px solid #3b4253;">
        <table class="tax-table">
          <tr><td colspan="<%= intra ? 7 : 5 %>" class="shade" style="border-top:none; border-left:none; text-align:left;">Tax Summary:</td></tr>
          <tr>
            <th rowspan="2" style="border-left:none; text-align:center;">HSN/ SAC</th>
            <th rowspan="2">Taxable amount (₹)</th>
            <% if (intra) { %>
              <th colspan="2">CGST</th>
              <th colspan="2">SGST</th>
            <% } else { %>
              <th colspan="2">IGST</th>
            <% } %>
            <th rowspan="2" style="border-right:none;">Total Tax(₹)</th>
          </tr>
          <tr>
            <% for (var k = 0; k < (intra ? 2 : 1); k++) { %><th>Rate (%)</th><th>Amt (₹)</th><% } %>
          </tr>
          <% hsnTaxGroups.forEach(function(g) { %>
            <tr>
              <td style="border-left:none;"><%= g.hsn %></td>
              <td><%= formatMoney(g.taxableAmount) %></td>
              <% if (intra) { %>
                <td><%= (g.taxRate / 2).toFixed(1) %></td><td><%= formatMoney(g.cgst) %></td>
                <td><%= (g.taxRate / 2).toFixed(1) %></td><td><%= formatMoney(g.sgst) %></td>
              <% } else { %>
                <td><%= g.taxRate.toFixed(1) %></td><td><%= formatMoney(g.igst) %></td>
              <% } %>
              <td style="border-right:none;"><%= formatMoney(g.totalTax) %></td>
            </tr>
          <% }) %>
          <tr style="font-weight:700;">
            <td style="border-left:none; text-align:center;">TOTAL</td>
            <td><%= formatMoney(invoice.taxableAmount) %></td>
            <% if (intra) { %>
              <td></td><td><%= formatMoney(invoice.cgst) %></td>
              <td></td><td><%= formatMoney(invoice.sgst) %></td>
            <% } else { %>
              <td></td><td><%= formatMoney(invoice.igst) %></td>
            <% } %>
            <td style="border-right:none;"><%= formatMoney(Number(invoice.cgst) + Number(invoice.sgst) + Number(invoice.igst)) %></td>
          </tr>
        </table>
      </td>
      <td>
        <table class="totals">
          <tr><td style="border-top:none;">Sub Total</td><td class="sep" style="border-top:none;">:</td><td class="num" style="border-top:none;">₹ <%= formatMoney(itemTotals.amount) %></td></tr>
          <% if (Number(invoice.discount) > 0) { %>
            <tr><td>Discount</td><td class="sep">:</td><td class="num">- ₹ <%= formatMoney(invoice.discount) %></td></tr>
          <% } %>
          <% if (Number(invoice.roundOff) !== 0) { %>
            <tr><td>Round Off</td><td class="sep">:</td><td class="num">₹ <%= formatMoney(invoice.roundOff) %></td></tr>
          <% } %>
          <tr style="font-weight:700;"><td>Total</td><td class="sep">:</td><td class="num">₹ <%= formatMoney(invoice.total) %></td></tr>
          <tr><td colspan="3" class="shade">Invoice Amount In Words :</td></tr>
          <tr><td colspan="3"><%= amountInWords %></td></tr>
          <tr><td>Received</td><td class="sep">:</td><td class="num">₹ <%= formatMoney(invoice.receivedAmount) %></td></tr>
          <tr><td style="border-bottom:none;">Balance</td><td class="sep" style="border-bottom:none;">:</td><td class="num" style="border-bottom:none;">₹ <%= formatMoney(invoice.balance) %></td></tr>
          <%
            var totalSavings = 0;
            if (invoice.items) { invoice.items.forEach(function(i) { totalSavings += Number(i.discount || 0); }); }
            totalSavings += Number(invoice.discount || 0);
            if (Number(invoice.roundOff) < 0) totalSavings += Math.abs(Number(invoice.roundOff));
          %>
          <% if (totalSavings > 0) { %>
          <tr style="font-weight: 600;">
            <td style="border-bottom:none;">Total You Saved</td><td class="sep" style="border-bottom:none;">:</td><td class="num" style="border-bottom:none;">₹ <%= formatMoney(totalSavings) %></td>
          </tr>
          <% } %>
        </table>
      </td>
    </tr>
  </table>

  <table class="footer">
    <tr>
      <td class="shade" style="width:50%;">Bank Details:</td>
      <td class="shade">For <%= business.name.toUpperCase() %>:</td>
    </tr>
    <tr>
      <td style="height:100px; line-height: 1.6;">
        <% if (business.bankName) { %><div>Name: <strong><%= business.bankName %></strong></div><% } %>
        <% if (business.bankAccountNo) { %><div>Account No.: <strong><%= business.bankAccountNo %></strong></div><% } %>
        <% if (business.bankIfsc) { %><div>IFSC code: <strong><%= business.bankIfsc %></strong></div><% } %>
        <% if (business.bankAccountHolder) { %><div>Account Holder's Name: <strong><%= business.bankAccountHolder %></strong></div><% } %>
      </td>
      <td class="center">
      </td>
    </tr>
  </table>
  </div>
</div>
