<%- include('../partials/layout-start', { title: config.label + ' ' + invoice.invoiceNo, activeNav: config.activeNav }) %>
<%
  var cancelled = invoice.status === 'CANCELLED';
  var settles = !!config.settlementDirection;
  var activeAllocations = invoice.allocations.filter(function(a) { return a.voucher.status === 'ACTIVE'; });
  var returnBase = config.docType === 'SALE_INVOICE' ? '/credit-notes' : (config.docType === 'PURCHASE_BILL' ? '/debit-notes' : null);
  function inr(n) { return '₹' + Number(n).toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2}); }
%>

<%
  var statusBadge = cancelled ? '<span class="status-badge status-cancelled">Cancelled</span>'
    : config.docType === 'ESTIMATE' ? '<span class="status-badge ' + (invoice.convertedTo ? 'status-paid' : 'status-open') + '">' + (invoice.convertedTo ? 'Converted' : 'Open') + '</span>'
    : '<span class="status-badge ' + paymentStatusClass(invoice.paymentStatus) + '">' + paymentStatusLabel(invoice.paymentStatus) + '</span>';
  var acts = '';
  if (!cancelled) {
    if (settles && Number(invoice.balance) > 0) acts += '<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#paymentModal"><i class="icon-indian-rupee"></i> ' + (config.settlementDirection === 'IN' ? 'Receive payment' : 'Make payment') + '</button>';
    if (config.docType === 'ESTIMATE' && !invoice.convertedTo) acts += '<a href="/invoices/new?fromEstimate=' + invoice.id + '" class="btn btn-primary"><i class="icon-arrow-right-left"></i> Convert to invoice</a>';
    acts += '<a href="' + config.basePath + '/' + invoice.id + '/edit" class="btn btn-outline-secondary"><i class="icon-pencil"></i> Edit</a>';
  }
  acts += '<button type="button" class="btn btn-outline-secondary" onclick="window.print()" title="Print (Ctrl+P)"><i class="icon-printer"></i> Print</button>';
  acts += '<a href="' + config.basePath + '/' + invoice.id + '/pdf" class="btn btn-outline-secondary"><i class="icon-download"></i> PDF</a>';
  var more = '';
  if (!config.returnOf) more += '<li><a class="dropdown-item" href="' + config.basePath + '/new?duplicateOf=' + invoice.id + '"><i class="icon-copy"></i> Duplicate</a></li>';
  if (!cancelled) {
    if (returnBase) more += '<li><a class="dropdown-item" href="' + returnBase + '/new?against=' + invoice.id + '"><i class="icon-undo-2"></i> ' + (config.docType === 'SALE_INVOICE' ? 'Sale return (credit note)' : 'Purchase return (debit note)') + '</a></li>';
    if (more) more += '<li><hr class="dropdown-divider"></li>';
    more += '<li><button type="submit" form="cancelDocForm" class="dropdown-item text-danger"><i class="icon-ban"></i> Cancel ' + config.label.toLowerCase() + '…</button></li>';
  }
  if (more) {
    acts += '<div class="dropdown"><button class="btn btn-outline-secondary btn-icon" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More actions" title="More actions"><i class="icon-ellipsis"></i></button><ul class="dropdown-menu dropdown-menu-end">' + more + '</ul></div>';
  }
%>
<div class="page page-medium" data-shortcut-print>
<%- include('../partials/page-header', {
  title: config.label + ' ' + invoice.invoiceNo,
  badge: statusBadge,
  subtitle: customer.name + (divisionText(invoice) ? ' · ' + divisionText(invoice) : '') + ' · ' + fdate(invoice.invoiceDate) + ' · ' + inr(invoice.total) + (settles && !cancelled && Number(invoice.balance) > 0 ? ' · ' + inr(invoice.balance) + ' due' : ''),
  back: { href: config.basePath, label: config.pluralLabel, key: config.basePath },
  actions: acts
}) %>

<% if (cancelled) { %>
  <div class="alert alert-secondary no-print">
    <strong>Cancelled</strong> <%= invoice.cancelledAt ? 'on ' + fdate(invoice.cancelledAt) : '' %><%= invoice.cancelReason ? ' — ' + invoice.cancelReason : '' %>.
    Its stock and balance effects were reversed; the number stays used.
  </div>
<% } %>

<% if (invoice.importedFrom && invoice.importedFrom.files.length) { %>
<div class="alert alert-secondary no-print d-flex flex-wrap gap-2 align-items-center"><i class="icon-paperclip"></i> Supplier's document:
  <% invoice.importedFrom.files.forEach(function (f) { %><a href="/purchases/import/<%= invoice.importedFrom.id %>/files/<%= f.id %>" target="_blank" rel="noopener"><%= f.originalName %></a><% }) %>
  <a class="ms-auto small" href="/purchases/import/<%= invoice.importedFrom.id %>">Import details</a>
</div>
<% } %>
<% if (invoice.convertedFrom || invoice.convertedTo || invoice.originalDoc || invoice.returns.length || activeAllocations.length) { %>
<div class="panel mb-3 no-print">
  <div class="panel-header"><h2 class="panel-title">Linked records</h2></div>
  <div class="table-scroll">
    <table class="table table-app">
      <tbody>
        <% if (invoice.convertedFrom) { %><tr><td style="width:180px" class="muted">Created from estimate</td><td><a href="/estimates/<%= invoice.convertedFrom.id %>" class="cell-main"><%= invoice.convertedFrom.invoiceNo %></a></td><td></td></tr><% } %>
        <% if (invoice.convertedTo) { %><tr><td style="width:180px" class="muted">Converted to invoice</td><td><a href="/invoices/<%= invoice.convertedTo.id %>" class="cell-main"><%= invoice.convertedTo.invoiceNo %></a><%= invoice.convertedTo.status === 'CANCELLED' ? ' (cancelled)' : '' %></td><td></td></tr><% } %>
        <% if (invoice.originalDoc) { %>
          <tr><td class="muted">Returned against</td><td><a href="<%= invoice.originalDoc.docType === 'SALE_INVOICE' ? '/invoices' : '/purchases' %>/<%= invoice.originalDoc.id %>" class="cell-main"><%= invoice.originalDoc.invoiceNo %></a> <span class="cell-sub">dated <%= fdate(invoice.originalDoc.invoiceDate) %></span></td><td class="num"><%= inr(invoice.adjustedAmount) %> set off</td></tr>
        <% } %>
        <% invoice.returns.forEach(function(r) { %>
          <tr><td class="muted"><%= r.docType === 'CREDIT_NOTE' ? 'Credit note' : 'Debit note' %></td><td><a href="<%= r.docType === 'CREDIT_NOTE' ? '/credit-notes' : '/debit-notes' %>/<%= r.id %>" class="cell-main"><%= r.invoiceNo %></a> <span class="cell-sub"><%= fdate(r.invoiceDate) %> · <%= inr(r.total) %></span></td><td class="num"><%= inr(r.adjustedAmount) %> set off</td></tr>
        <% }) %>
        <% activeAllocations.forEach(function(a) { %>
          <tr><td class="muted">Payment</td><td><a href="/payments/<%= a.voucher.id %>" class="cell-main"><%= a.voucher.voucherNo %></a> <span class="cell-sub"><%= fdate(a.voucher.date) %> · <%= modeLabel(a.voucher.mode) %><%= a.voucher.reference ? ' · ' + a.voucher.reference : '' %></span></td><td class="num"><%= inr(a.amount) %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<div class="card doc-scroll">
  <%- include('_invoice-document') %>
</div>
</div>

<% if (settles && !cancelled) { %>
<div class="modal fade no-print" id="paymentModal" tabindex="-1" data-bs-backdrop="static" aria-labelledby="paymentModalTitle">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="<%= config.basePath %>/<%= invoice.id %>/payment" data-dialog-form>
        <input type="hidden" name="clientToken" value="<%= paymentToken %>">
        <div class="modal-header">
          <h2 class="modal-title" id="paymentModalTitle"><%= config.settlementDirection === 'IN' ? 'Receive payment' : 'Make payment' %> · <%= invoice.invoiceNo %></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger d-none" role="alert" tabindex="-1" data-dialog-error></div>
          <div class="mb-3">
            <label class="form-label" for="payAmount">Amount</label>
            <div class="price-pair w-money"><span class="rupee">₹</span><input type="number" id="payAmount" name="amount" class="form-control" min="0.01" step="0.01" max="<%= Number(invoice.balance) %>" value="<%= Number(invoice.balance) %>" required></div>
            <div class="form-text">Balance due: <%= inr(invoice.balance) %></div>
          </div>
          <div class="row g-2">
            <div class="col-6">
              <label class="form-label">Mode</label>
              <select name="type" class="form-select">
                <option value="CASH">Cash</option>
                <option value="UPI">UPI</option>
                <option value="BANK_TRANSFER">Bank Transfer</option>
                <option value="CARD">Card</option>
                <option value="OTHER">Other</option>
              </select>
            </div>
            <div class="col-6">
              <label class="form-label">Date</label>
              <input type="date" name="date" class="form-control" value="<%= new Date().toISOString().slice(0,10) %>">
            </div>
          </div>
          <div class="mt-2">
            <label class="form-label">Reference <span class="text-muted fw-normal">(UTR / cheque no.)</span></label>
            <input type="text" name="reference" class="form-control" maxlength="60">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
          <button type="submit" class="btn btn-primary">Save payment</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<% if (!cancelled) { %>
<form id="cancelDocForm" method="POST" action="<%= config.basePath %>/<%= invoice.id %>/cancel" class="d-none"
      data-confirm="<%= config.label %> <%= invoice.invoiceNo %> stays on record as cancelled and its number is not reused. Its stock and party-balance effects are reversed.<%= activeAllocations.length ? ' It has payments recorded, which must be cancelled first.' : '' %>"
      data-confirm-title="Cancel <%= config.label.toLowerCase() %> <%= invoice.invoiceNo %>?"
      data-confirm-label="Cancel <%= config.label.toLowerCase() %>"
      data-confirm-cancel="Keep <%= config.label.toLowerCase() %>"
      data-confirm-busy="Cancelling…"
      data-confirm-reason="reason"
      data-confirm-reason-placeholder="e.g. Entered twice by mistake"></form>
<% } %>

<%- include('../partials/layout-end') %>
