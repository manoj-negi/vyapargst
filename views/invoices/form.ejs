<%- include('../partials/layout-start', { title: invoice ? 'Edit Invoice ' + invoice.invoiceNo : 'Create Sale Invoice', activeNav: 'invoices' }) %>

<div class="sale-page">
  <% if (errors && errors.length) { %>
    <div class="alert alert-danger py-2 small">
      <ul class="mb-0 ps-3"><% errors.forEach(function(e) { %><li><%= e %></li><% }) %></ul>
    </div>
  <% } %>

  <form method="POST" action="<%= invoice ? '/invoices/' + invoice.id + '/edit' : '/invoices' %>" id="invoiceForm" data-business-state="<%= business.state %>">
    <section class="sale-hero">
      <div class="sale-hero-customer">
        <div class="sale-eyebrow"><i class="icon-receipt-indian-rupee"></i> <%= invoice ? 'Edit Sale' : 'New Sale' %></div>
        <label class="form-label small fw-semibold" for="customerSelect">Bill To *</label>
        <div class="d-flex gap-2">
          <select name="customerId" id="customerSelect" class="form-select" required>
            <option value="">Select Customer</option>
            <% customers.forEach(function(c) { %>
              <option value="<%= c.id %>" data-state="<%= c.state %>" <%= invoice && invoice.customerId === c.id ? 'selected' : '' %>><%= c.name %><%= c.section ? ' (' + c.section + ')' : '' %><%= c.phone ? ' · ' + c.phone : '' %></option>
            <% }) %>
          </select>
          <button type="button" class="btn btn-outline-primary text-nowrap" data-bs-toggle="modal" data-bs-target="#newCustomerModal">
            <i class="icon-plus"></i> New Customer
          </button>
        </div>
        <div class="mt-2">
          <span id="placeOfSupplyBadge" class="badge text-bg-secondary">Select a customer</span>
        </div>
      </div>
      <div class="sale-hero-dates">
        <div>
          <label class="form-label small fw-semibold" for="invoiceDate">Invoice Date</label>
          <input type="date" name="invoiceDate" id="invoiceDate" class="form-control" value="<%= invoice ? new Date(invoice.invoiceDate).toISOString().slice(0,10) : new Date().toISOString().slice(0,10) %>">
        </div>
        <div>
          <label class="form-label small fw-semibold" for="dueDate">Due Date</label>
          <input type="date" name="dueDate" id="dueDate" class="form-control" value="<%= invoice && invoice.dueDate ? new Date(invoice.dueDate).toISOString().slice(0,10) : '' %>">
        </div>
      </div>
    </section>

    <section class="sale-panel">
      <div class="sale-panel-head">
        <h6 class="sale-panel-title">Items</h6>
        <button type="button" id="addRowBtn" class="btn btn-sm sale-add-row"><i class="icon-plus"></i> Add Row</button>
      </div>
      <div class="table-scroll">
        <table class="table table-app sale-items-table mb-0">
          <thead>
            <tr>
              <th class="c-num">#</th>
              <th class="c-item">Item</th>
              <th class="c-qty">Qty</th>
              <th class="c-unit">Unit</th>
              <th class="c-price">Price/Unit</th>
              <th class="c-disc">Discount</th>
              <th class="c-amt">Taxable</th>
              <th class="c-gst">GST</th>
              <th class="c-amt col-cgst-sgst">CGST</th>
              <th class="c-amt col-cgst-sgst">SGST</th>
              <th class="c-amt col-igst d-none">IGST</th>
              <th class="c-amt">Total</th>
              <th class="c-del"></th>
            </tr>
          </thead>
          <tbody id="itemsTbody"></tbody>
        </table>
      </div>
    </section>

    <div class="sale-bottom">
      <section class="sale-panel">
        <h6 class="sale-panel-title">Payment</h6>
        <div class="sale-payment-grid">
          <div>
            <label class="form-label small fw-semibold" for="paymentType">Payment Type</label>
            <select name="paymentType" id="paymentType" class="form-select">
              <option value="CASH">Cash</option>
              <option value="UPI">UPI</option>
              <option value="BANK_TRANSFER">Bank Transfer</option>
              <option value="CARD">Card</option>
              <option value="CREDIT">Credit</option>
              <option value="OTHER">Other</option>
            </select>
          </div>
          <div>
            <label class="form-label small fw-semibold" for="receivedInput">Received Amount</label>
            <div class="input-group">
              <span class="input-group-text">₹</span>
              <input type="number" name="receivedAmount" id="receivedInput" class="form-control" min="0" step="0.01" value="<%= invoice ? invoice.receivedAmount : 0 %>" <%= invoice && invoice.receivedAmount > 0 ? 'readonly' : '' %>>
            </div>
            <% if (invoice && invoice.receivedAmount > 0) { %>
              <div class="form-text text-muted">Use 'Record Payment' to change this.</div>
            <% } %>
          </div>
        </div>
        <div class="sale-balance">
          <div>
            <div class="text-muted small">Balance Due</div>
            <div id="balanceDisplay" class="sale-balance-value">₹0.00</div>
          </div>
          <span id="paymentStatusBadge" class="status-badge status-unpaid">UNPAID</span>
        </div>
      </section>

      <section class="sale-receipt">
        <div class="sale-receipt-row">
          <span>Invoice Discount</span>
          <div class="sale-inv-discount">
            <input type="number" name="invoiceDiscountValue" id="invoiceDiscountValue" class="form-control form-control-sm" value="<%= invoice ? invoice.discount : 0 %>" min="0" step="0.01" aria-label="Invoice discount">
            <select name="invoiceDiscountType" id="invoiceDiscountType" class="form-select form-select-sm" aria-label="Invoice discount type">
              <option value="PERCENTAGE">%</option>
              <option value="FIXED" <%= invoice ? 'selected' : '' %>>₹</option>
            </select>
          </div>
        </div>
        <div class="sale-receipt-divider"></div>
        <div class="sale-receipt-row"><span>Subtotal</span><span id="subtotalDisplay">₹0.00</span></div>
        <div class="sale-receipt-row"><span>Discount</span><span id="discountDisplay">₹0.00</span></div>
        <div class="sale-receipt-row fw-semibold"><span>Taxable Amount</span><span id="taxableDisplay">₹0.00</span></div>
        <div class="sale-receipt-row col-cgst-sgst"><span>CGST</span><span id="cgstDisplay">₹0.00</span></div>
        <div class="sale-receipt-row col-cgst-sgst"><span>SGST</span><span id="sgstDisplay">₹0.00</span></div>
        <div class="sale-receipt-row col-igst d-none"><span>IGST</span><span id="igstDisplay">₹0.00</span></div>
        <div class="sale-receipt-row"><span>CESS</span><span id="cessDisplay">₹0.00</span></div>
        <div class="sale-receipt-row"><span>Round Off</span><span id="roundOffDisplay">₹0.00</span></div>
        <div class="sale-receipt-total">
          <span>Total</span>
          <span id="grandTotalDisplay">₹0.00</span>
        </div>
        <input type="hidden" id="grandTotalHidden" value="0">
      </section>
    </div>

    <div class="sale-actionbar">
      <div>
        <div class="sale-actionbar-label"><span id="itemCountDisplay">0 items</span> · Grand Total</div>
        <div id="stickyTotalDisplay" class="sale-actionbar-total">₹0.00</div>
      </div>
      <div class="d-flex gap-2">
        <a href="/invoices" class="btn sale-btn-ghost">Cancel</a>
        <button type="submit" class="btn sale-btn-save" data-shortcut-save>Save Invoice <kbd>Ctrl+S</kbd></button>
      </div>
    </div>
  </form>
</div>

<template id="itemRowTemplate">
  <tr class="invoice-item-row">
    <td class="row-number">1</td>
    <td>
      <input type="text" class="form-control form-control-sm item-name-input" data-name="productName" placeholder="Type item name..." autocomplete="off" required>
      <input type="hidden" class="product-id-input" data-name="productId">
      <input type="hidden" class="hsn-input" data-name="hsn">
      <input type="hidden" class="unit-input" data-name="unit">
      <input type="hidden" class="price-type-input" data-name="priceType" value="EXCLUSIVE">
      <input type="hidden" class="gst-rate-input" data-name="gstRate" value="0">
      <div class="autocomplete-menu"></div>
    </td>
    <td><input type="number" class="form-control form-control-sm qty-input" data-name="quantity" min="0.01" step="0.01" value="1"></td>
    <td><span class="unit-display">-</span></td>
    <td><input type="number" class="form-control form-control-sm price-input" data-name="unitPrice" min="0" step="0.01" value="0"></td>
    <td>
      <div class="input-group input-group-sm sale-disc-group">
        <input type="number" class="form-control discount-input" data-name="discountValue" min="0" step="0.01" value="0">
        <select class="form-select discount-type-select" data-name="discountType">
          <option value="PERCENTAGE">%</option>
          <option value="FIXED">₹</option>
        </select>
      </div>
    </td>
    <td class="taxable-cell">₹0.00</td>
    <td class="gst-rate-cell-label">0%</td>
    <td class="cgst-cell col-cgst-sgst">₹0.00</td>
    <td class="sgst-cell col-cgst-sgst">₹0.00</td>
    <td class="igst-cell col-igst d-none">₹0.00</td>
    <td class="total-cell fw-semibold">₹0.00</td>
    <td><button type="button" class="sale-remove-row remove-row-btn" title="Remove row" aria-label="Remove row"><i class="icon-trash-2"></i></button></td>
  </tr>
</template>

<%# Kept outside #invoiceForm — HTML forms cannot be nested. %>
<div class="modal fade" id="newCustomerModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form id="newCustomerForm" novalidate>
        <div class="modal-header">
          <h6 class="modal-title fw-bold">New Customer</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div id="newCustomerErrors" class="alert alert-danger py-2 small d-none"></div>
          <%- include('../customers/_fields', { customer: null, states: states, defaultState: business.state }) %>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary-app" id="newCustomerSave">Save Customer</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  window.__invoiceExistingItems = <%- invoice ? JSON.stringify(invoice.items) : '[]' %>;
  (function () {
    var modalEl = document.getElementById('newCustomerModal');
    var form = document.getElementById('newCustomerForm');
    var errorsBox = document.getElementById('newCustomerErrors');
    var saveBtn = document.getElementById('newCustomerSave');
    var select = document.getElementById('customerSelect');

    function showErrors(messages) {
      errorsBox.innerHTML = '';
      var ul = document.createElement('ul');
      ul.className = 'mb-0 ps-3';
      messages.forEach(function (m) { var li = document.createElement('li'); li.textContent = m; ul.appendChild(li); });
      errorsBox.appendChild(ul);
      errorsBox.classList.remove('d-none');
    }

    modalEl.addEventListener('shown.bs.modal', function () { form.elements.name.focus(); });
    modalEl.addEventListener('hidden.bs.modal', function () { errorsBox.classList.add('d-none'); });

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      saveBtn.disabled = true;
      try {
        var res = await fetch('/api/customers', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        var body = await res.json();
        if (!res.ok) { showErrors(body.errors || [body.error || 'Could not save customer']); return; }

        var c = body.customer;
        var sectionText = c.section ? ' (' + c.section + ')' : '';
        var optionText = c.name + sectionText + (c.phone ? ' · ' + c.phone : '');
        var option = new Option(optionText, c.id, true, true);
        option.dataset.state = c.state;
        select.add(option);
        // Let the invoice form recalculate place of supply / CGST-SGST vs IGST for the new customer.
        select.dispatchEvent(new Event('change', { bubbles: true }));

        form.reset();
        bootstrap.Modal.getInstance(modalEl).hide();
      } catch (err) {
        showErrors(['Network error — please try again.']);
      } finally {
        saveBtn.disabled = false;
      }
    });
  })();
</script>
<script src="/js/invoice-form.js"></script>
<%- include('../partials/layout-end') %>
